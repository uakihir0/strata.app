# cmake -P script, run by the strata.metallib step after metallib and metal-dsymutil
# (docs/mac/08-build-and-distribution.md, section 5.4).  Inputs: XCRUN, MANIFEST, AIRS (| separated), TMP (the
# linked metallib), METALLIB (its final name), INC (the hash header).
#
# The kernels in the AIR files must match the manifest exactly: each listed function defined once, in the folder
# of its math mode; no kernel that the manifest does not list; no helper with external linkage (it would be a
# second definition when another file includes the same header); and no fast-math call in a safe file, which
# `fast::exp` and friends make even under -fmetal-math-mode=safe.  Only then does TMP become METALLIB.
file(STRINGS ${MANIFEST} _lines)
set(_names "")
foreach(_line IN LISTS _lines)
  if(_line MATCHES "^([a-z_][a-z0-9_]*) (safe|fast) [1-9][0-9]* [1-9][0-9]* [1-9][0-9]*$")
    list(APPEND _names ${CMAKE_MATCH_1})
    set(_mode_${CMAKE_MATCH_1} ${CMAKE_MATCH_2})
  endif()
endforeach()

set(_errors "")
string(REPLACE "|" ";" _airs "${AIRS}")
foreach(_air IN LISTS _airs)
  get_filename_component(_dir ${_air} DIRECTORY)
  get_filename_component(_mode ${_dir} NAME)
  get_filename_component(_n ${_air} NAME_WE)
  set(_src "src/metal/kernels/${_mode}/${_n}.metal")
  execute_process(COMMAND ${XCRUN} -sdk macosx metal-nm ${_air} OUTPUT_VARIABLE _nm RESULT_VARIABLE _rc)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "metal-nm failed on ${_air}")
  endif()
  string(REPLACE "\n" ";" _nm "${_nm}")
  foreach(_sym IN LISTS _nm)
    if(_sym MATCHES "^[-0-9a-f]+ T (.+)$")
      set(_f ${CMAKE_MATCH_1})
      if(_f MATCHES "^_Z")
        list(APPEND _errors "${_src}: ${_f} has external linkage (make the helper static or inline)")
      elseif(NOT _f IN_LIST _names)
        list(APPEND _errors "${_src}: kernel ${_f} is not in src/metal/kernels/manifest.txt")
      elseif(DEFINED _seen_${_f})
        list(APPEND _errors "${_src}: kernel ${_f} is also defined in ${_seen_${_f}}")
      elseif(NOT _mode_${_f} STREQUAL _mode)
        list(APPEND _errors "${_src}: kernel ${_f} is listed as ${_mode_${_f}} math but lives in ${_mode}/")
        set(_seen_${_f} ${_src})
      else()
        set(_seen_${_f} ${_src})
      endif()
    elseif(_mode STREQUAL "safe" AND _sym MATCHES "^ +U (air\\.fast_.+)$")
      list(APPEND _errors "${_src}: calls ${CMAKE_MATCH_1} (a fast:: function) in a safe-math file")
    endif()
  endforeach()
endforeach()
foreach(_f IN LISTS _names)
  if(NOT DEFINED _seen_${_f})
    list(APPEND _errors "src/metal/kernels/manifest.txt: kernel ${_f} is defined in no .metal file")
  endif()
endforeach()
if(_errors)
  list(JOIN _errors "\n  " _msg)
  message(FATAL_ERROR "strata.metallib does not match its manifest:\n  ${_msg}")
endif()

# the linked library must export exactly the manifest's functions (a guard against a metallib tool change)
execute_process(COMMAND ${XCRUN} -sdk macosx metal-nm ${TMP} OUTPUT_VARIABLE _nm RESULT_VARIABLE _rc)
string(REGEX MATCHALL "[0-9a-f]+ T [^\n]+" _defs "${_nm}")
list(TRANSFORM _defs REPLACE "^[0-9a-f]+ T " "")
list(SORT _defs)
set(_want ${_names})
list(SORT _want)
if(NOT _rc EQUAL 0 OR NOT _defs STREQUAL _want)
  message(FATAL_ERROR "strata.metallib exports '${_defs}', the manifest lists '${_want}'")
endif()

file(RENAME ${TMP} ${METALLIB})
file(SHA256 ${METALLIB} _h)
file(WRITE ${INC}.tmp "#define STRATA_METALLIB_SHA256 \"${_h}\"\n")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${INC}.tmp ${INC})
file(REMOVE ${INC}.tmp)

function(strata_metal_test name label)
  add_test(NAME ${name} COMMAND ${ARGN})
  set_tests_properties(${name} PROPERTIES LABELS ${label})
endfunction()
strata_metal_test(m1 metal true)
strata_metal_test(k1 model true)
function(_strata_label_rest)
  get_property(_tests DIRECTORY ${CMAKE_SOURCE_DIR} PROPERTY TESTS)
  foreach(t IN LISTS _tests)
    get_test_property(${t} LABELS _l)
    if(NOT _l)
      set_tests_properties(${t} PROPERTIES LABELS host)
    endif()
  endforeach()
endfunction()
cmake_language(DEFER DIRECTORY ${CMAKE_SOURCE_DIR} CALL _strata_label_rest)

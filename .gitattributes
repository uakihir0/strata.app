# Frozen prompts are hashed byte for byte (manifest sha256): never convert their line endings.
bench/prompts/** -text

# POSIX shell scripts use LF line endings on macOS.
*.sh text eol=lf
# Finder launchers run through /bin/sh: a CRLF ending fails with "bad interpreter" (docs/mac/07, section 5.2).
*.command text eol=lf

# MAC: Metal sources and the files CMake parses keep LF on every clone (docs/mac/08-build-and-distribution.md, section 3.5)
*.metal text eol=lf
src/metal/kernels/manifest.txt text eol=lf
METAL_REV text eol=lf
